# Public site URL, used for canonical links, sitemap, and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://necxmedia.com

# YouTube video ID for the hero VSL (the part after "v=" or after "youtu.be/").
NEXT_PUBLIC_YOUTUBE_VIDEO_ID=Df_MkNlI9CM

# Optional: Google Analytics 4 measurement ID. Leave unset to disable analytics.
NEXT_PUBLIC_GA_ID=

# --- Lead forms ---
# The site is a static export hosted on GitHub Pages, so the /apply and /book
# forms POST directly to the Apps Script Web App (ends in /exec). In CI this
# comes from the NEXT_PUBLIC_LEAD_WEBHOOK_URL GitHub Actions secret.
# Sheet writes + Resend emails happen inside that script — see apps-script/Code.gs
# (Resend key lives in the script's Script Properties, not here).
NEXT_PUBLIC_LEAD_WEBHOOK_URL=
