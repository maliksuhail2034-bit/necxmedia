# Public site URL, used for canonical links, sitemap, and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://necxmedia.com

# YouTube video ID for the hero VSL (the part after "v=" or after "youtu.be/").
NEXT_PUBLIC_YOUTUBE_VIDEO_ID=Df_MkNlI9CM

# Optional: Google Analytics 4 measurement ID. Leave unset to disable analytics.
NEXT_PUBLIC_GA_ID=

# --- Google Sheets lead storage (server-only, never expose these to the browser) ---
# Create a Google Cloud service account, share the target Sheet with its email
# (Editor access), and set these from the service account JSON key.
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# --- Email (server-only) ---
# Resend API key (https://resend.com). Leave unset to skip sending confirmation
# emails — leads still get recorded in Google Sheets either way.
EMAIL_PROVIDER_API_KEY=
# Must be a sender address on a domain verified in your Resend account.
EMAIL_FROM="NECXMEDIA <leads@necxmedia.com>"
# Where internal new-application notifications go. Defaults to the site's contact
# email (see lib/content.ts) if unset.
EMAIL_TO=
